{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lipu-geo",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "routes": [{ "pattern": "geo.lipu.dev", "custom_domain": true }],
  "workers_dev": false,
  "rules": [{ "type": "Text", "globs": ["**/client/*.js"], "fallthrough": false }]
}
